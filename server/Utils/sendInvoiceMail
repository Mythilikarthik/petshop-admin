require("dotenv").config();
const nodemailer = require("nodemailer");

const transporter = nodemailer.createTransport({
  service: "gmail", 
  auth: {
    user: process.env.SMTP_USER, // Your email address from .env
    pass: process.env.SMTP_PASS  // Your email App Password from .env
  }
});

const sendInvoiceMail = async (toEmail, userName, planDetails, paymentId, amount, endDate) => {
  try {
    const logoUrl = "https://www.vetandpets.in/images/logo.png";
    const mailOptions = {
      from: `"Vet and Pets Directory Team" <${process.env.SMTP_USER}>`,
      to: toEmail,
      subject: `Payment Invoice: ${planDetails.name} Activated!`,
      html: `
        <div style="font-family: Arial, sans-serif; padding: 25px; color: #333; max-width: 600px; margin: auto; border: 1px solid #e0e0e0; border-radius: 8px;">
          <!-- Logo -->
          <div style="text-align: center; margin-bottom: 20px;">
            <img src="${logoUrl}" alt="VetandPets Logo" style="max-width: 150px; height: auto;" />
          </div>
            <h2 style="color: #28a745; text-align: center;">Payment Successful!</h2>
          <p>Hello <strong>${userName || "Valued Customer"}</strong>,</p>
          <p>Thank you for upgrading! Your payment has been successfully processed and your premium plan features are now active.</p>
          
          <hr style="border: none; border-top: 1px solid #eee; margin: 20px 0;" />
          
          <h3 style="color: #495057;">Invoice Summary</h3>
          <table style="width: 100%; border-collapse: collapse; margin-bottom: 20px;">
            <tr>
              <td style="padding: 8px 0; color: #6c757d;">Plan Name:</td>
              <td style="padding: 8px 0; text-align: right; font-weight: bold;">${planDetails.name}</td>
            </tr>
            <tr>
              <td style="padding: 8px 0; color: #6c757d;">Billing Cycle:</td>
              <td style="padding: 8px 0; text-align: right; text-transform: capitalize;">${planDetails.billingCycle}</td>
            </tr>
            <tr>
              <td style="padding: 8px 0; color: #6c757d;">Amount Paid:</td>
              <td style="padding: 8px 0; text-align: right; font-weight: bold; color: #28a745;">₹${amount}</td>
            </tr>
            <tr>
              <td style="padding: 8px 0; color: #6c757d;">Transaction ID:</td>
              <td style="padding: 8px 0; text-align: right; font-family: monospace; font-size: 13px;">${paymentId}</td>
            </tr>
            <tr>
              <td style="padding: 8px 0; color: #6c757d;">Valid Until:</td>
              <td style="padding: 8px 0; text-align: right;">${new Date(endDate).toDateString()}</td>
            </tr>
          </table>        
          
          <p style="margin-top: 30px; font-size: 12px; color: #6c757d; text-align: center;">
            Best regards,<br /><strong>Vet and Pets Team</strong>
          </p>
        </div>
      `
    };

    await transporter.sendMail(mailOptions);
    console.log(`Invoice email successfully sent to ${toEmail}`);
  } catch (error) {
    console.error("Error sending invoice email:", error);
  }
};

module.exports = sendInvoiceMail;